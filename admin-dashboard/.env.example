NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Optional extra lock: only these phones can open the panel, comma separated,
# full international form (example +237600000000). If empty, only the founder
# created at /login can sign in as staff.
ADMIN_PHONES=

# Unlocks the founder door on this browser once:
# open http://localhost:3001/login?desk=YOUR_SECRET then bookmark /login.
# Without this cookie the login page is a 404.
# If empty, local development accepts ?desk=open
ADMIN_DESK_KEY=

# Service role key from Supabase (Project settings, API). Server side only.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to run the founder panel on this computer only. Sign-in stays in
# the browser and does not call Supabase. Use this when the cloud project
# is unreachable.
ADMIN_LOCAL=
