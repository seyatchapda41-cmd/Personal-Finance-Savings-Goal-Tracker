NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Founder panel at /admin. Phone numbers allowed in, comma separated, in full
# international form. Leave empty and the panel stays shut.
ADMIN_PHONES=

# Service role key from Supabase (Project settings, API). Server side only:
# it bypasses row level security so the panel can read and change every
# client's rows. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
