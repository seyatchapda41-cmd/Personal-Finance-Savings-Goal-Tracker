NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional extra lock: only these phones can open /admin, comma separated,
# full international form (example +237600000000). If empty, only the founder
# created at /admin/login can sign in as staff. Nobody else can be added later.
ADMIN_PHONES=

# Service role key from Supabase (Project settings, API). Server side only:
# it bypasses row level security so the panel can read and change every
# client's rows. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
