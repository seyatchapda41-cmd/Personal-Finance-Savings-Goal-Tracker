NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Optional extra lock: only these phones can open the founder panel, comma
# separated, full international form (example +237600000000). If empty, only
# the founder created at the admin app /login can sign in as staff.
ADMIN_PHONES=

# Unlocks the founder door on this browser once:
# open http://localhost:3001/login?desk=YOUR_SECRET then bookmark that page.
# Customers never see Staff links. Without this cookie they get a 404.
# If empty, local development accepts ?desk=open
ADMIN_DESK_KEY=

# Service role key from Supabase (Project settings, API). Server side only:
# it bypasses row level security so the panel can read and change every
# client's rows. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
